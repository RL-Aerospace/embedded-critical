{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "--no-python-downloads",
              "--locked",
              "--quiet",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"
            ],
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking command against repo guards"
          }
        ]
      }
    ]
  }
}
